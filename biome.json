{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!**/coverage",
			"!!**/.next",
			"!!**/.turbo",
			"!!**/drizzle",
			"!!**/*.sqlite*"
		],
		"ignoreUnknown": true,
		"maxSize": 1048576
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"includes": [
			"src/**",
			"styles/**",
			"build.ts",
			"drizzle.config.ts",
			".zed/**",
			"components.json"
		],
		"domains": {
			"drizzle": "recommended",
			"project": "recommended",
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useLiteralKeys": "off"
			},
			"correctness": {
				"noUndeclaredDependencies": "error",
				"noUnusedImports": "error"
			},
			"style": {
				"useImportType": "error"
			},
			"suspicious": {
				"noDrizzleDeleteWithoutWhere": {
					"level": "error",
					"options": {
						"drizzleObjectName": ["db"]
					}
				},
				"noDrizzleUpdateWithoutWhere": {
					"level": "error",
					"options": {
						"drizzleObjectName": ["db"]
					}
				}
			}
		}
	},
	"javascript": {
		"jsxRuntime": "transparent"
	},
	"json": {
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	},
	"assist": {
		"enabled": true,
		"includes": ["src/**", "styles/**", "build.ts", "drizzle.config.ts", ".zed/**"],
		"actions": {
			"preset": "recommended",
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":BUN:", ":NODE:"],
							":BLANK_LINE:",
							["react", "react/**", "react-*", "react-*/**"],
							":BLANK_LINE:",
							[":PACKAGE:", "!@/**"],
							":BLANK_LINE:",
							"@/**",
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{test,spec}.{js,jsx,ts,tsx}", "src/**/test/**", "src/**/tests/**"],
			"linter": {
				"domains": {
					"test": "recommended"
				}
			}
		},
		{
			"includes": ["src/server.ts", "src/server/**/*.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	]
}
