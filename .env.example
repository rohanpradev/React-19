PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
# Optional rotation keyring. First entry encrypts new data; older entries remain decryption-only.
# BETTER_AUTH_SECRETS=2:new-secret-at-least-32-characters,1:old-secret-at-least-32-characters
# Optional proxy-specific header that your edge overwrites and clients cannot spoof.
# BETTER_AUTH_IP_ADDRESS_HEADERS=cf-connecting-ip
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
