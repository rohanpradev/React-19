{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun run build && NODE_ENV=production bun dist/index.js",
		"build": "bun build.ts",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"format:changed": "bun fmt --changed",
		"format:staged": "bun fmt --staged",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"typecheck": "bun --check",
		"typecheck:diagnostics": "tsc -p tsconfig.json --noEmit --extendedDiagnostics",
		"typecheck:single": "tsc -p tsconfig.json --noEmit --singleThreaded",
		"validate": "bun src/tooling/validate.ts",
		"validate:quick": "bun src/tooling/validate.ts --quick",
		"validate:ci": "bun src/tooling/validate.ts --audit",
		"db:check": "drizzle-kit check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun src/db/seed.ts",
		"access:bootstrap": "bun src/tooling/bootstrap-admin.ts",
		"test": "bun test src",
		"test:production": "bun src/production-smoke.ts",
		"audit": "bun audit"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@js-temporal/polyfill": "^0.5.1",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-table": "^9.3.1",
		"better-auth": "^1.7.12",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.0",
		"drizzle-orm": "1.0.0-rc.5",
		"lucide-react": "^1.61.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "1.0.0-rc.5",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4"
}
