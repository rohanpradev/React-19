{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun run build && NODE_ENV=production bun dist/index.js",
		"build": "bun build.ts",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"typecheck": "tsgo -p tsconfig.json --noEmit",
		"typecheck:diagnostics": "tsgo -p tsconfig.json --noEmit --extendedDiagnostics",
		"typecheck:single": "tsgo -p tsconfig.json --noEmit --singleThreaded",
		"validate": "bun run build && bun run check && bun run typecheck && bun run db:check && bun run test",
		"db:check": "drizzle-kit check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun src/db/seed.ts",
		"test": "bun test src",
		"audit": "bun audit"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@js-temporal/polyfill": "^0.5.1",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.103.2",
		"@tanstack/react-table": "^9.2.4",
		"better-auth": "^1.7.5",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "1.0.0-rc.4",
		"lucide-react": "^1.47.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"tailwind-merge": "^3.7.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"drizzle-kit": "1.0.0-rc.4",
		"tailwindcss": "^4.3.3"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2"
	}
}
