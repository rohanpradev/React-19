{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun run build && NODE_ENV=production bun src/index.ts",
		"build": "bun build.ts",
		"check": "bunx --bun biome check .",
		"check:write": "bunx --bun biome check --write .",
		"typecheck": "bunx --bun tsgo -p tsconfig.json --noEmit",
		"typecheck:diagnostics": "bunx --bun tsgo -p tsconfig.json --noEmit --extendedDiagnostics",
		"typecheck:single": "bunx --bun tsgo -p tsconfig.json --noEmit --singleThreaded",
		"validate": "bun run check && bun run typecheck && bun run build",
		"db:generate": "bunx drizzle-kit generate",
		"db:seed": "bun src/db/seed.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@js-temporal/polyfill": "^0.5.1",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-form": "^1.33.4",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-table": "^9.1.2",
		"better-auth": "^1.6.26",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"lucide-react": "^1.30.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"tailwind-merge": "^3.6.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"drizzle-kit": "^1.0.0-rc.4",
		"tailwindcss": "^4.3.3"
	}
}
